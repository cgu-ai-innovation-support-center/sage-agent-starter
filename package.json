{
  "name": "@cgu-sage/agent-starter",
  "version": "0.1.5",
  "private": true,
  "description": "Source-available starter templates for CGU SAGE self-hosted Agents",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "customization:check": "node scripts/check-customization.mjs",
    "doctor": "node scripts/doctor.mjs",
    "https:doctor": "node scripts/https-kit.mjs doctor",
    "https:export": "node scripts/https-kit.mjs export",
    "https:setup": "node scripts/https-kit.mjs setup",
    "release:verify": "node scripts/verify-release.mjs",
    "test": "npm run test:full",
    "test:full": "node scripts/validate.mjs --full",
    "test:light": "node scripts/validate.mjs",
    "test:node": "node --test tests/node/*.test.mjs",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:smoke": "node scripts/smoke-containers.mjs"
  },
  "license": "SEE LICENSE IN LICENSE"
}
