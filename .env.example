# Use a distinct random value with at least 32 characters. Never reuse a model key.
AGENT_INVOCATION_KEY=replace-with-a-random-agent-invocation-secret

# This must be one model allowed by the SAGE Budget selected at run time.
# Local doctor can check only the configured shape; a real SAGE run verifies access.
AGENT_MODEL=replace-with-an-allowed-model-alias

# Exact public HTTPS origin of the SAGE deployment that mints run leases.
SAGE_PLATFORM_ORIGIN=replace-with-your-sage-https-origin

# The local SQLite file must live on persistent storage in a real deployment.
AGENT_STATE_DB=./data/agent-state.sqlite

PORT=8080

# Optional external HTTPS download link demonstration; omit by default.
# AGENT_ARTIFACT_URL=https://files.example.edu/example.pdf

# Private HTTPS uses a separate generated .env.https and ignored data/https.
# Do not put CA/server private keys or sage-agent-trust.json values in this file.
